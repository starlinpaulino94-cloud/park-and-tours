# Environment variables — copy to .env.local and fill in. NEVER commit real values.
# .env / .envProd / .env*.local are gitignored; this .example carries NO secrets.

# ─────────────────────────────────────────────────────────────────────────────
# ACTIVE STACK (Supabase + Vercel)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_USE_RLS=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (kept; point at the deployment origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (kept)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Stripe Price IDs allowed for authenticated checkout.
STRIPE_ALLOWED_PRICE_IDS=

# Optional comma-separated origins allowed to embed the app in iframes.
# Empty means frame-ancestors 'self'. Example: https://partner.example.com
ALLOWED_FRAME_ANCESTORS=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
