# Environment variables — copy to .env.local and fill in. NEVER commit real values.
# .env / .envProd / .env*.local are gitignored; this .example carries NO secrets.

# ─────────────────────────────────────────────────────────────────────────────
# ACTIVE STACK (Supabase + Vercel)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_USE_RLS=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (kept; point at the deployment origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# TAREAS PROGRAMADAS (Vercel Cron)
# ─────────────────────────────────────────────────────────────────────────────
# Secreto que autentica /api/cron/*. Vercel lo envía como
# `Authorization: Bearer <CRON_SECRET>`. Sin él, la ruta responde 503 y ninguna
# tarea programada se ejecuta. Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Zona horaria por defecto cuando una empresa no tiene `timezone` configurado.
DEFAULT_TIMEZONE=America/Santo_Domingo

# ─────────────────────────────────────────────────────────────────────────────
# COMUNICACIONES CON EL CLIENTE
# ─────────────────────────────────────────────────────────────────────────────
# Las credenciales viven AQUÍ y nunca en la base: la pantalla de integraciones
# lee sus filas y las manda al navegador, así que una clave guardada por
# inquilino quedaría publicada.
#
# Sin estas variables el sistema NO pierde avisos: los compone, los deja en la
# bandeja de salida con el motivo escrito y los entrega en cuanto existan.
#
# Correo (Resend). MESSAGING_FROM_EMAIL tiene que ser de un dominio verificado.
RESEND_API_KEY=
MESSAGING_FROM_EMAIL=
MESSAGING_FROM_NAME=

# WhatsApp (Meta Cloud API). El token es el permanente de la app, no el temporal.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# E2E RESPONSIVE (Playwright)
# ─────────────────────────────────────────────────────────────────────────────
# Cuenta de prueba para validar flujos reales en navegador. Si faltan, los tests
# E2E se omiten explícitamente; no uses cuentas personales ni commitees valores.
E2E_EMAIL=
E2E_PASSWORD=
# Opcional: URL ya desplegada. Vacío levanta `npm run test:serve` localmente.
E2E_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# MEMBEGO (membresías y fidelización — plataforma hermana)
# ─────────────────────────────────────────────────────────────────────────────
# Secreto compartido que imprime UNA sola vez `scripts/registrar-sistema.ts` de
# MembeGo al dar de alta este sistema en su vertical de excursiones. Firma el
# token del SSO (/sso/membego) y los webhooks (/api/membego/webhook). Sin él,
# ambos rechazan todo. Nunca se comparte la service_role de ningún lado: esto
# es lo ÚNICO que viaja entre las dos plataformas.
MEMBEGO_SECRETO=

# API de plataforma de MembeGo (canje de beneficios desde el punto de venta).
# Son credenciales OAuth2 *client credentials* del SISTEMA Park & Tours, no de
# una empresa: la empresa viaja en cada llamada y MembeGo comprueba que este
# sistema esté habilitado para ella. Las emite MembeGo al dar de alta el sistema
# y hay que pedirlas con los permisos «benefits:read benefits:redeem»: con solo
# el primero, consultar funciona y canjear falla en el mostrador con el cliente
# delante.
#
# Sin estas tres, el canje simplemente no se ofrece; el resto de la integración
# (SSO y webhooks) sigue funcionando con MEMBEGO_SECRETO.
MEMBEGO_API_URL=https://www.membego.com
MEMBEGO_CLIENT_ID=
MEMBEGO_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (kept)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Stripe Price IDs allowed for authenticated checkout.
STRIPE_ALLOWED_PRICE_IDS=

# Optional comma-separated origins allowed to embed the app in iframes.
# Empty means frame-ancestors 'self'. Example: https://partner.example.com
ALLOWED_FRAME_ANCESTORS=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=
# ── Sentry ──────────────────────────────────────────────────────────────────
# Sin DSN, Sentry queda DESACTIVADO (no-op). Rellena para activar en producción.
# NEXT_PUBLIC_SENTRY_DSN=   # cliente (navegador)
# SENTRY_DSN=               # servidor (fallback al público si falta)
# Solo en CI/Vercel para subir source maps — NUNCA commitear el token:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Tracing de performance (0 = solo errores). Opt-in:
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────────────────────
# DEMOSTRACIÓN (scripts/seed-demo-presentation.mjs)
# ─────────────────────────────────────────────────────────────────────────────
# De quién se deriva la empresa de demostración: su empresa real da el nombre,
# y todas las personas de esa empresa reciben acceso a la demo.
# DEMO_OWNER_EMAIL=
#
# Contraseña de las tres cuentas de demostración (mínimo 12 caracteres). Sin
# ella el sembrador genera una y la imprime UNA vez al terminar, que es lo
# recomendable: una contraseña de demostración escrita en un archivo es la que
# nadie cambia nunca. NUNCA commitear un valor aquí.
# DEMO_USER_PASSWORD=
